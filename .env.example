# Copier ce fichier en .env et adapter les valeurs à votre environnement local.

DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL (active par défaut) ---
DB_NAME=gestion_scolaire
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Base de données MySQL (alternative) ---
# DB_NAME=gestion_scolaire
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Celery & Redis (tâches asynchrones) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# --- E-mail (réinitialisation de mot de passe, envoi de documents) ---
# Backends possibles :
#   - console  : les e-mails s'affichent dans la console (développement)
#   - smtp     : envoi réel (Gmail, Outlook, Brevo, SMTP établissement...)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=Gestion Scolaire <no-reply@exemple.com>
